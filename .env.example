# Application Settings
PROJECT_NAME=Geospatial File Measurement API
VERSION=1.0.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/geospatial_db
POOL_SIZE=20
MAX_OVERFLOW=20
POOL_TIMEOUT=30.0
POOL_PRE_PING=false
POOL_RECYCLE=1800

# File Storage & Worker Concurrency
UPLOAD_DIR=uploads
TARGET_PROJECTED_CRS=EPSG:3857
MAX_CONCURRENT_WORKERS=4
MAX_CONCURRENT_JOBS=2

# Rate Limiting (slowapi, per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POST_FILES=30/minute
RATE_LIMIT_GET_FILES=300/minute

# Response Caching (cachetools TTLCache)
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=300
